{
  "name": "FareedQ.com",
  "baseUrl": "http://127.0.0.1:4400",
  "note": "Serve the CSP-enabled preview (node tools/csp-preview.mjs 4400) so captures match production headers.",
  "pixelBudget": 640000,
  "maxTileAspect": 1.6,
  "viewports": [
    {
      "name": "desktop",
      "width": 1440,
      "height": 900
    },
    {
      "name": "mobile",
      "width": 390,
      "height": 844
    }
  ],
  "pages": [
    {
      "key": "home",
      "label": "Homepage",
      "route": "/",
      "regions": [
        {
          "name": "hero",
          "selector": ".hero"
        },
        {
          "name": "hero-actions",
          "selector": ".hero__actions"
        },
        {
          "name": "work",
          "selector": "section[aria-labelledby=\"work-title\"]"
        },
        {
          "name": "invite",
          "selector": "section[aria-labelledby=\"invite-title\"]"
        },
        {
          "name": "photo",
          "selector": ".photo"
        }
      ]
    },
    {
      "key": "coaching",
      "label": "Coaching",
      "route": "/coaching/",
      "regions": [
        {
          "name": "head",
          "selector": ".page-head"
        },
        {
          "name": "pricing",
          "selector": "#pricing"
        },
        {
          "name": "start",
          "selector": "section[aria-labelledby=\"start-title\"]"
        }
      ]
    },
    {
      "key": "faq",
      "label": "FAQ",
      "route": "/faq/",
      "regions": [
        {
          "name": "head",
          "selector": ".page-head"
        },
        {
          "name": "questions",
          "selector": ".faq"
        },
        {
          "name": "terms",
          "selector": "#terms"
        }
      ]
    },
    {
      "key": "consultation",
      "label": "Initial consultation form",
      "route": "/consultation/",
      "regions": [
        {
          "name": "head",
          "selector": ".band--paper .split"
        },
        {
          "name": "form",
          "selector": ".ob-form"
        },
        {
          "name": "next",
          "selector": ".ob-how"
        }
      ]
    },
    {
      "key": "about",
      "label": "About Me",
      "route": "/about/",
      "regions": [
        {
          "name": "portrait",
          "selector": ".page-head__media"
        }
      ]
    },
    {
      "key": "terms",
      "label": "Practical terms and scope",
      "route": "/work-with-me/",
      "regions": [
        {
          "name": "terms",
          "selector": "#terms"
        },
        {
          "name": "scope",
          "selector": "#scope"
        }
      ]
    },
    {
      "key": "framework",
      "label": "Philosophy overview",
      "route": "/framework/",
      "regions": []
    },
    {
      "key": "regulation",
      "label": "Nervous system regulation",
      "route": "/framework/regulation/",
      "regions": []
    },
    {
      "key": "mvl",
      "label": "Minimal viable life",
      "route": "/framework/minimal-viable-life/",
      "regions": []
    },
    {
      "key": "participation",
      "label": "Participation",
      "route": "/framework/participation/",
      "regions": []
    }
  ],
  "measurements": {
    "selectors": [
      "h1",
      ".hero__title",
      "h2",
      "p",
      ".label",
      ".btn",
      ".faq__q",
      ".list__body",
      ".facts__row dd",
      ".hero__note"
    ]
  },
  "regression": {
    "pages": [
      "home",
      "coaching",
      "faq",
      "consultation",
      "terms",
      "about"
    ],
    "viewports": [
      "desktop",
      "mobile"
    ],
    "mask": [],
    "tolerance": {
      "pixelRatio": 0.002,
      "channelDelta": 16
    },
    "baselines": "visual-audit/baselines",
    "approval": "Baselines are only written by `regress.mjs --mode seed --reason \"...\"`; compare mode never writes them."
  },
  "budgets": {
    "note": "M2: measured per page and asserted in the audit run.",
    "jsGzipKb": 15,
    "cssGzipKb": 20,
    "clsMax": 0.02
  },
  "designIntent": "visual-audit/design-intent.md",
  "a11y": {
    "tags": [
      "wcag2a",
      "wcag2aa",
      "wcag21aa",
      "wcag22aa"
    ],
    "note": "Automated checks are laboratory results. Screen-reader semantics, focus logic and cognitive load need a human."
  },
  "performance": {
    "budgets": {
      "jsGzipKb": 15,
      "cssGzipKb": 20,
      "clsMax": 0.02,
      "lcpMs": 1500,
      "transferKb": 600,
      "longTasksMax": 0
    },
    "note": "Laboratory budgets for a static site. Measure and adjust; they are guardrails, not targets."
  }
}